# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartagri

# Auth
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External APIs
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_API_URL=https://api.sarvam.ai

# Maps (optional - falls back to Haversine)
MAPS_API_KEY=
MAPS_PROVIDER=haversine

# Weather (optional)
WEATHER_API_KEY=

# App Config
DEMO_MODE=true
TRANSPORT_RATE_PER_KM_PER_TON=4.0
MARKET_FEE_PERCENT=1.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEMO_MODE=true
