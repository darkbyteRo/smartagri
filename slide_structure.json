      {
        "name": "TextBox 1",
        "id": 2,
        "left": 48125,
        "top": 1164789,
        "width": 6631807,
        "height": 2862322,
        "type": "TEXT_BOX (17)",
        "text": " FEASIBILITY — WHY IT CAN WORK\nExisting Technology: Next.js, FastAPI, PostgreSQL and ML are proven technologies.\nAvailable Data: Mandi price data can be sourced from Agmarknet.\nModular System: Price prediction, buyer matching and advisory can work as independent modules.\nRegional Access: Telugu voice/text through Sarvam AI makes the platform easier for farmers to use.\nScalable: Can expand from pilot markets to more crops, districts and FPOs."
      },
      {
        "name": "TextBox 2",
        "id": 3,
        "left": 0,
        "top": 4121075,
        "width": 6728059,
        "height": 2031325,
        "type": "TEXT_BOX (17)",
        "text": " KEY CHALLENGES & RISKS\nStale / unavailable mandi data\nIncorrect price predictions due to sudden market or weather changes\nPoor rural internet connectivity\nBuyer cancellations or payment issues\nQuality disputes between farmers and buyers\nVariation in transportation costs"
      },
      {
        "name": "TextBox 3",
        "id": 4,
        "left": 6679932,
        "top": 804672,
        "width": 5350005,
        "height": 3693319,
        "type": "TEXT_BOX (17)",
        "text": " STRATEGIES TO OVERCOME\nData Failure → Use historical price fallback + clearly show last update time.\nPrediction Risk → Show confidence level & risk category; avoid guaranteed predictions.\nPoor Connectivity → Lightweight interface + offline caching + sync when internet returns.\nBuyer Risk → Reliability score + verified buyer profiles + cancellation tracking.\nQuality Disputes → Standardized produce photos + agreed quality criteria + dispute mechanism.\nTransport Cost Changes → Allow farmers to update local transport rates."
      },
      {
        "name": "TextBox 4",
        "id": 5,
        "left": 6473953,
        "top": 4407409,
        "width": 5901620,
        "height": 1754326,
        "type": "TEXT_BOX (17)",
        "text": "VIABILITY\nLow-cost Software → Existing Data Sources → Modular AI → Regional Language → Scalable Deployment\nResult: A practical, scalable platform that can continue functioning even when individual data, connectivity or prediction components fail."
      }
    ]
  },
